# Copy to .env, then set local secrets there. Never commit .env.
DATABASE_USER=
DATABASE_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MEDIA_FACTORY_IMAGE_PROVIDER=mock
MEDIA_FACTORY_ENVIRONMENT=development
OPENAI_IMAGE_ENABLED=false
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_CONNECT_TIMEOUT=10s
OPENAI_IMAGE_TIMEOUT=120s
OPENAI_REQUESTS_PER_MINUTE=20
OPENAI_MAX_CONCURRENT=3
OPENAI_MAX_ATTEMPTS=3
OPENAI_RETRY_AMBIGUOUS=false
IMAGE_FALLBACK_ENABLED=false
IMAGE_FALLBACK_PROVIDERS=
MOCK_PRODUCTION_FALLBACK_ENABLED=false
MOCK_IMAGE_SCENARIO=success
IMAGE_WORKER_CONCURRENCY=4
# Visual QA defaults to deterministic free mocks. Real Vision is independently opt-in.
VISION_PROVIDER=mock
OPENAI_VISION_ENABLED=false
OPENAI_VISION_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_VISION_TIMEOUT_SECONDS=90
MOCK_VISION_SCENARIO=PERFECT
QA_WORKER_CONCURRENCY=3
VISION_REQUESTS_PER_MINUTE=120
VISION_MAX_CALLS=4
VISION_MAX_ATTEMPTS=2
VISION_RETRY_AMBIGUOUS=false
VISION_FALLBACK_PROVIDERS=
