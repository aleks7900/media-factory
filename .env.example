# Copy to .env, then set local secrets there. Never commit .env.
DATABASE_USER=
DATABASE_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MEDIA_FACTORY_IMAGE_PROVIDER=mock
MEDIA_FACTORY_ENVIRONMENT=development
OPENAI_IMAGE_ENABLED=false
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_CONNECT_TIMEOUT=10s
OPENAI_IMAGE_TIMEOUT=120s
OPENAI_REQUESTS_PER_MINUTE=20
OPENAI_MAX_CONCURRENT=3
OPENAI_MAX_ATTEMPTS=3
OPENAI_RETRY_AMBIGUOUS=false

# Gemini Image Generation
GEMINI_API_KEY=
GEMINI_IMAGE_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/
IMAGE_FALLBACK_ENABLED=false
IMAGE_FALLBACK_PROVIDERS=
MOCK_PRODUCTION_FALLBACK_ENABLED=false
MOCK_IMAGE_SCENARIO=success
IMAGE_WORKER_CONCURRENCY=4
# Visual QA defaults to deterministic free mocks. Real Vision is independently opt-in.
VISION_PROVIDER=mock
OPENAI_VISION_ENABLED=false
OPENAI_VISION_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_VISION_TIMEOUT_SECONDS=90
MOCK_VISION_SCENARIO=PERFECT
QA_WORKER_CONCURRENCY=3
VISION_REQUESTS_PER_MINUTE=120
VISION_MAX_CALLS=4
VISION_MAX_ATTEMPTS=2
VISION_RETRY_AMBIGUOUS=false
VISION_FALLBACK_PROVIDERS=

# ==============================================================================
# TikTok Content Posting API Configuration
# ==============================================================================
TIKTOK_ENABLED=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/publishing/tiktok/callback
PUBLISHING_WORKER_ENABLED=true
PUBLISHING_WORKER_CONCURRENCY=2

# ==============================================================================
# Admin & JWT Authentication Configuration
# ==============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@mediafactory.local
JWT_SECRET=
JWT_EXPIRATION_SECONDS=86400
AUTH_COOKIE_NAME=media_factory_jwt
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
MEDIA_FACTORY_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000

